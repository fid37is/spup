# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Spup

# ─── Paystack ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...              # Server-only

# ─── Cloudinary (Media) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...                     # Server-only
CLOUDINARY_API_SECRET=...                  # Server-only

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                      # Server-only

# ─── Push Notifications ───────────────────────────────────────────────────────
# Web push (browser/PWA). Generate with: npx web-push generate-vapid-keys
# The public key must be NEXT_PUBLIC_ so the browser can subscribe with it.
VAPID_PUBLIC_KEY=...                       # Server-only
VAPID_PRIVATE_KEY=...                      # Server-only
VAPID_SUBJECT=mailto:support@spup.live     # Contact URL/email required by the Web Push spec
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...           # Same value as VAPID_PUBLIC_KEY, exposed to the client

# Native push (Android/iOS via Capacitor + Firebase Cloud Messaging).
# Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the ENTIRE downloaded JSON as a single-line string.
# For iOS delivery, also upload your APNs auth key to the same Firebase
# project (Project settings → Cloud Messaging → Apple app configuration) —
# FCM delivers to iOS via APNs under the hood once that's configured.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'  # Server-only

# ─── Matchday scores (Explore page) ───────────────────────────────────────────
# Powers the score-card strip under Explore's tabs. Free tier at
# https://www.football-data.org — sign up, grab your token. Covers EPL,
# Championship, Champions League, etc. If unset, the strip just doesn't render.
MATCHDAY_API_KEY=...                       # Server-only

# ─── Identity verification (KYC) ───────────────────────────────────────────────
# NIN is the baseline check — required before any withdrawal, and what
# earns the "Verified" badge (lib/actions/nin-kyc.ts). BVN is an additional
# check only required for large withdrawals (lib/actions/bvn-kyc.ts,
# lib/constants.ts). Both are currently placeholders — wire up a real KYC
# provider (Prembly / YouVerify / Smile ID / dojah.io all support NIN + BVN
# lookups) before going live; see the TODOs at the top of each file.
NIN_HASH_PEPPER=...                        # Server-only — random string, never commit
NIN_KYC_PROVIDER_API_KEY=...               # Server-only
BVN_HASH_PEPPER=...                        # Server-only — random string, never commit
BVN_KYC_PROVIDER_API_KEY=...               # Server-only
