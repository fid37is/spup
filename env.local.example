# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Spup

# Optional. Only needed in production if you want the auth cookie shared
# across subdomains (e.g. spup.live <-> www.spup.live). Leave unset in local
# dev — do NOT set this to "localhost" or ".localhost", see
# src/lib/supabase/cookie-options.ts for why.
# NEXT_PUBLIC_COOKIE_DOMAIN=.spup.live

# ─── Paystack ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...              # Server-only

# ─── Cloudinary (Media) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...                     # Server-only
CLOUDINARY_API_SECRET=...                  # Server-only

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                      # Server-only
